# Copy to .env and fill in. Docker Compose reads .env from this folder.

# Required. Seals the login cookies. At least 32 characters; make one with:
#   openssl rand -base64 32
# Changing it logs everyone out.
NUXT_APP_SECRET=

# The login cookie is only sent over HTTPS. Keep this true when the site is behind HTTPS
# (Caddy, Cloudflare Tunnel, Tailscale Funnel). Set it to false only if you open the site as
# plain http://<pi>:3000 on your home network; otherwise logging in silently fails there.
NUXT_SESSION_COOKIE_SECURE=true

# Set to true when a tunnel or reverse proxy sits in front (Cloudflare Tunnel, Tailscale
# Funnel, Caddy). The limits on wrong passwords and new accounts then count per visitor;
# without it every visitor seems to come from the proxy. Leave false when the port is
# reached directly.
NUXT_TRUST_PROXY=false

# Registration closes when this many accounts exist.
NUXT_MAX_USERS=200

# The port on the host.
PORT=3000
