# Copy to .env and fill in. Docker Compose reads .env from this folder.

# Required. Seals the login cookies. At least 32 characters; make one with:
#   openssl rand -base64 32
# Changing it logs everyone out.
NUXT_APP_SECRET=

# The login cookie is only sent over HTTPS. Keep this true when the site is behind HTTPS
# (Caddy, Cloudflare Tunnel, Tailscale Funnel). Set it to false only if you open the site as
# plain http://<pi>:3000 on your home network; otherwise logging in silently fails there.
NUXT_SESSION_COOKIE_SECURE=true

# Set to true when a tunnel or reverse proxy sits in front (Cloudflare Tunnel, Tailscale
# Funnel, Caddy). The limits on wrong passwords and new accounts then count per visitor;
# without it every visitor seems to come from the proxy. Leave false when the port is
# reached directly.
NUXT_TRUST_PROXY=false

# Registration closes when this many accounts exist.
NUXT_MAX_USERS=200

# Required. Firebase Authentication holds the passwords and sends the "forgot password" mails.
# The Web API key from the Firebase console: Project settings → General. See the README.
NUXT_FIREBASE_API_KEY=

# Optional: "Doorgaan met Google" on the login page. Leave empty to offer only email and password.
# Turn Google on in Firebase first; use the OAuth client Firebase made for it ("Web client (auto
# created by Google Service)") and add the redirect URL below to it, exactly as written here.
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
# The site's own address followed by /auth/google, e.g. https://pakske.example.com/auth/google
NUXT_OAUTH_GOOGLE_REDIRECT_URL=

# Who runs this site, for its privacy page (/privacy) and its terms (/terms). The name is who
# answers for the site, the address is where people send questions about their data. Both are
# shown on those pages. Empty: the pages say "the person who runs this site" and give no address.
NUXT_PUBLIC_OPERATOR_NAME=
NUXT_PUBLIC_OPERATOR_EMAIL=
# Optional: the company whose tunnel or proxy carries the traffic to this server, e.g.
# Cloudflare. The privacy page then says the connection runs through it.
NUXT_PUBLIC_OPERATOR_NETWORK=

# The port on the host.
PORT=3000
