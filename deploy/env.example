# Settings for Pakske on the Pi. Copy to ~/.config/pakske.env and fill in.
# pm2 hands them to the server. Keep it readable by you only: chmod 600.
# Node reads this file itself, so write full paths: $HOME does not work here.
# What each setting means: docs/deploying.md.

# Only listen on the Pi itself; Cloudflare Tunnel connects to this port.
HOST=127.0.0.1
PORT=3030

# The database and the uploaded images. Outside the checkout, so a deploy never touches them.
NUXT_DATA_DIR=/home/<you>/pakske-data

# Make one with: openssl rand -base64 32. Changing it logs everyone out.
NUXT_APP_SECRET=

# Behind Cloudflare Tunnel: HTTPS only, and the tunnel is the one proxy in front.
NUXT_SESSION_COOKIE_SECURE=true
NUXT_TRUST_PROXY=true

NUXT_MAX_USERS=200

NUXT_FIREBASE_API_KEY=

# Who runs the site, shown on its privacy page and its terms, and where questions go.
NUXT_PUBLIC_OPERATOR_NAME=
NUXT_PUBLIC_OPERATOR_EMAIL=
# The tunnel in front carries every request, so the privacy page names it.
NUXT_PUBLIC_OPERATOR_NETWORK=Cloudflare
# Where deploy/backup.sh sends the nightly backups, so the privacy page names that too.
NUXT_PUBLIC_OPERATOR_BACKUPS=Cloudflare

# Optional: "Doorgaan met Google". The redirect URL must also be listed at Google.
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
NUXT_OAUTH_GOOGLE_REDIRECT_URL=https://pakske.example.com/auth/google
