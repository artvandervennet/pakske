# One run of the deploy script. Started by pakske-deploy.timer.
#   ~/.config/systemd/user/pakske-deploy.service
[Unit]
Description=Deploy Pakske when there is a new release

[Service]
Type=oneshot
ExecStart=%h/pakske/deploy/deploy.sh
# what each deploy did, newest at the bottom
StandardOutput=append:%h/.local/share/pakske/deploy.log
StandardError=append:%h/.local/share/pakske/deploy.log
