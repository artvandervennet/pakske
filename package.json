{
  "name": "pakske",
  "description": "A wishlist site for family and friends, where the owners of a wish never see what was bought",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/artvandervennet/pakske.git"
  },
